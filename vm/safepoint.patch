+// Safepoint, when set, is called once every safepointInterval executed
+// instructions. A WebAssembly host has no other way to stop a guest that
+// loops without allocating: Go's wasm port has no asynchronous preemption,
+// so such a loop never reaches a host import. The counter is not atomic;
+// the hook is meant for single-threaded embeddings.
+var Safepoint func()
+
+const safepointInterval = 1 << 14
+
+var safepointCount uint32
